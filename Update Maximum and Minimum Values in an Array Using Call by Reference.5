#include <stdio.h>

void findMaxMin(int a[], int n, int *max, int *min)
{
    int i;

    *max = a[0];
    *min = a[0];

    for (i = 1; i < n; i++)
    {
        if (a[i] > *max)
            *max = a[i];

        if (a[i] < *min)
            *min = a[i];
    }
}

int main()
{
    int a[5], i, max, min;

    printf("Enter 5 array elements:\n");

    for (i = 0; i < 5; i++)
        scanf("%d", &a[i]);

    findMaxMin(a, 5, &max, &min);

    printf("Maximum value = %d\n", max);
    printf("Minimum value = %d\n", min);

    return 0;
}
